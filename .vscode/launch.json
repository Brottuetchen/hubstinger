{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (iOS Simulator)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "iPhone"
    },
    {
      "name": "Flutter (Android)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "android"
    },
    {
      "name": "Flutter (Chrome)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "chrome"
    },
    {
      "name": "FastAPI Backend",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8080"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Flutter + Backend)",
      "configurations": ["FastAPI Backend", "Flutter (Chrome)"]
    }
  ]
}
