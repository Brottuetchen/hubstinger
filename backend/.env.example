# Family Hub Backend - Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#   nano .env

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED – generate with: openssl rand -hex 32
SECRET_KEY=

# ─── VAPID (Push Notifications) ──────────────────────────────────────────────
# Generate with: python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); v.save_files()"
# Or set from vapid_keys.json (auto-generated on first run)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Your email for VAPID contact (e.g. mailto:admin@your-domain.com)
VAPID_EMAIL=

# ─── Jellyfin ─────────────────────────────────────────────────────────────────
# URL of your Jellyfin instance (e.g. http://192.168.1.10:8096)
JELLYFIN_URL=
# API token: Jellyfin → Dashboard → API Keys → +
JELLYFIN_TOKEN=

# ─── Jellyseerr ───────────────────────────────────────────────────────────────
# URL of your Jellyseerr instance (e.g. http://192.168.1.10:5055)
JELLYSEERR_URL=
# API key: Jellyseerr → Settings → General → API Key
JELLYSEERR_API_KEY=

# ─── TMDB ─────────────────────────────────────────────────────────────────────
# Free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── Ollama ───────────────────────────────────────────────────────────────────
# URL of your Ollama instance (e.g. http://192.168.1.20:11434)
OLLAMA_URL=
# Model to use for German summaries (must be pulled: ollama pull <model>)
OLLAMA_MODEL=llama3.2

# ─── Uptime Kuma ──────────────────────────────────────────────────────────────
# Optional – URL of your Uptime Kuma instance for health webhooks
UPTIME_KUMA_URL=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
