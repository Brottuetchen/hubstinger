# Family Hub Backend - Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#   nano .env

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED – generate with: openssl rand -hex 32
# The backend will refuse to start without this set.
SECRET_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * for development, restrict in production.
# Example: CORS_ORIGINS=https://hub.example.com,https://app.example.com
CORS_ORIGINS=*

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
# Public URL of this backend – used for OIDC redirect_uri and push links
BACKEND_URL=http://localhost:8080

# ─── VAPID (Web Push Notifications) ──────────────────────────────────────────
# Auto-generated into vapid_keys.json on first start if not set here.
# Generate manually: cd backend && python -c "
#   from pywebpush import Vapid; v=Vapid(); v.generate_keys(); v.save_files()"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Contact email for VAPID – must be set for push to work
VAPID_EMAIL=

# ─── Authentik OIDC (optional) ────────────────────────────────────────────────
# Set these to enable "Login with Authentik" in the app.
# Setup: Authentik → Applications → Create OAuth2/OpenID Provider
#   Client type:    Confidential
#   Redirect URI:   {BACKEND_URL}/api/auth/oidc/callback
#   Scopes:         openid email profile
AUTHENTIK_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# ─── Jellyfin ─────────────────────────────────────────────────────────────────
# URL of your Jellyfin instance (e.g. http://192.168.1.10:8096)
JELLYFIN_URL=
# API token: Jellyfin → Dashboard → API Keys → +
JELLYFIN_TOKEN=

# ─── TMDB ─────────────────────────────────────────────────────────────────────
# Free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── Ollama ───────────────────────────────────────────────────────────────────
# URL of your Ollama instance (e.g. http://192.168.1.20:11434)
OLLAMA_URL=
# Model to use for German summaries (must be pulled: ollama pull <model>)
OLLAMA_MODEL=llama3.2

# ─── Optional integrations ────────────────────────────────────────────────────
# Uptime Kuma webhook source (for alert validation)
UPTIME_KUMA_URL=

# ─── Dev/Debug ────────────────────────────────────────────────────────────────
# Set to "true" to enable /docs (Swagger UI) – disable in production
ENABLE_DOCS=false
