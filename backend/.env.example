# Family Hub Backend - Environment Variables
# Copy to .env and fill in your values

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME

# ─── VAPID (Push Notifications) ──────────────────────────────────────────────
# Already generated in vapid_keys.json - or set here directly
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@t-acc.com

# ─── Jellyfin ─────────────────────────────────────────────────────────────────
JELLYFIN_URL=http://192.168.188.x:8096
JELLYFIN_TOKEN=

# ─── Jellyseerr ───────────────────────────────────────────────────────────────
JELLYSEERR_URL=http://192.168.188.x:5055
JELLYSEERR_API_KEY=

# ─── TMDB ─────────────────────────────────────────────────────────────────────
# Get free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Your machine running Ollama (Ryzen 9 7900X3D)
OLLAMA_URL=http://192.168.188.110:11434
OLLAMA_MODEL=qwen3:14b

# ─── Uptime Kuma ──────────────────────────────────────────────────────────────
UPTIME_KUMA_URL=http://192.168.188.x:3001

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
